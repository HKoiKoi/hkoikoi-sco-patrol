# 이 파일을 .env로 복사해 값을 채운다.
# shrimp-task-manager MCP 서버가 프로젝트 루트의 .env를 dotenv로 직접 읽으므로 셸 export는 필요 없다.

# shrimp 작업 데이터 저장 경로. 상대경로면 <프로젝트 루트>/shrimp_data/tasks.json,
# 절대경로면 하위에 프로젝트 폴더명이 한 단계 더 붙는다(<DATA_DIR>/<프로젝트명>/tasks.json).
DATA_DIR=shrimp_data
TEMPLATES_USE=ko
ENABLE_GUI=true

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
